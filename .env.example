# TGVmax API Configuration

# Port d'écoute HTTP
PORT=8000

# Secret pour l'endpoint POST /api/tgvmax/reload
RELOAD_SECRET=your-super-secret-key-here

# Token GitHub pour augmenter les quotas API (optionnel)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL de l'instance sur Render (pour reload automatique via Actions)
RENDER_TGVMAX_URL=https://your-app-name.onrender.com

# Mode debug (logs verbeux)
DEBUG=false

# Limite mémoire (en octets)
GOMEMORYALIMIT=350MiB
